# ── Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=9002

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=aura

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=60000
GEMINI_BATCH_PAGE_SIZE=12
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_MS=700
GEMINI_PROVIDER_TIMEOUT_SEC=120
GEMINI_CIRCUIT_BREAKER_THRESHOLD=5
GEMINI_CIRCUIT_BREAKER_COOLDOWN_SEC=90
GEMINI_SCHEMA_REPAIR_ATTEMPTS=2
GEMINI_FIELD_SELF_EVAL_ENABLED=true
GEMINI_FIELD_SELF_EVAL_MAX_FIELDS=60
GEMINI_FIELD_SELF_EVAL_MAX_CONTEXT_CHARS=15000
GEMINI_SUPPLEMENTAL_TEXT_MAX_CHARS=120000

# ── Processing ────────────────────────────────────────────
GEMINI_IMAGE_DPI=150
MAX_PDF_SIZE_MB=500
MAX_PAGES_PER_DOCUMENT=100
POPPLER_PATH=C:\Users\Ahmad\poppler\poppler-24.08.0\Library\bin

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
